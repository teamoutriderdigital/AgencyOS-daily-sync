# Supabase project credentials (Project Settings → API).
# The anon key is used by both the browser and the server. RLS on the daily/
# l10 tables is permissive (internal tool) — protect access at the deployment
# layer (e.g. Vercel password protection or a private network).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared team password gating the internal boards (/dashboard, /daily, /weekly,
# /rocks). The public /submit form is NOT gated. If unset, the gate is inert
# (fail-open) — set it in Vercel (Production + Preview) to turn protection on.
SITE_PASSWORD=choose-a-team-password

# Server-only Plane read key, used by the "Client work" subproject rows on
# /dashboard, /weekly and today's /daily (see src/lib/subprojects-server.ts).
# Get it from: Plane → Workspace Settings → API tokens. Never commit the value.
# Without it the Client work section renders an error instead of Plane rows.
PLANE_API_KEY=your-plane-api-key
